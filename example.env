# Bearer token Pebble uses to upload voice memos.
WEBHOOK_TOKEN=replace-with-a-long-random-pebble-token

# Set these to service addresses reachable from the Koebako worker.
STT_URL=
STT_MODEL_NAME=qwen3-asr-1.7b-q8_0

# Compatible transcript receiver (for example, Koemichi).
TRANSCRIPT_WEBHOOK_URL=
TRANSCRIPT_WEBHOOK_AUTH_HEADER=Authorization
TRANSCRIPT_WEBHOOK_AUTH_VALUE=Bearer replace-with-a-separate-long-random-service-token

# Pushover lifecycle notifications; set mode=off to omit the credentials.
NOTIFICATION_MODE=normal
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# Compose data directory on the host; this contains the Koebako DB and audio.
HOST_DATA_DIR=./data
TZ=Europe/Berlin
